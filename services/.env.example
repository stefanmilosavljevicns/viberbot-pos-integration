# Copy to .env for local Docker Compose use. Values below are placeholders.
VIBER_BOT_TOKEN=replace-with-a-test-bot-token
VIBER_BOT_PATH=/dentalcare-bot
VIBER_WEBHOOK_BASE_URL=https://replace-with-a-public-callback-host
VIBER_REGISTER_WEBHOOK=false
REST_API_URL=http://restapi:9097/api/v1
MONGODB_URI=mongodb://mongo:27017/viberbot
REMINDERS_ENABLED=false
