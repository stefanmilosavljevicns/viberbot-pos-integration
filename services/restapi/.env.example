# Required only by services/restapi/docker-compose.yml and services/bot/docker-compose.yml.
# Supply dedicated local/deployment values outside source control; never reuse production credentials for development.
MONGODB_URI=replace-with-a-secret-managed-mongodb-uri
MONGO_INITDB_ROOT_USERNAME=replace-with-a-secret-managed-username
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-secret-managed-password
VIBER_BOT_TOKEN=replace-with-a-test-bot-token
VIBER_WEBHOOK_BASE_URL=https://replace-with-a-public-callback-host
VIBER_REGISTER_WEBHOOK=false
